# ==============================================================================
# MEDIFLOW - CONFIGURACIÓN DE ENTORNO
# ==============================================================================

# Entorno de ejecución (development / staging / production)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=False

# Configuración OCI (Oracle Cloud Infrastructure)
# Autenticación por perfil local: el SDK resuelve las credenciales y la región.
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
# Alternativa: descomenta y completa TODAS estas variables para autenticación explícita.
# OCI_USER_OCID=ocid1.user.oc1..example
# OCI_FINGERPRINT=FINGERPRINT_DE_EJEMPLO
# OCI_KEY_FILE=~/.oci/oci_api_key.pem
# OCI_TENANCY_OCID=ocid1.tenancy.oc1..example
# OCI_REGION=REGION_DEL_ENTORNO
# OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..example

# OCI Object Storage: tres buckets independientes
OCI_BUCKET_RECIBIDOS=recibidos
OCI_BUCKET_PROCESADOS=procesados
OCI_BUCKET_AUDITORIA=auditoria_humana
# Opcional; por defecto se obtiene del SDK automáticamente.
# OCI_NAMESPACE=NAMESPACE_DEL_ENTORNO

# OCI Generative AI / Vision
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-ashburn-1.oci.oraclecloud.com
OCI_GENAI_MODEL_ID=cohere.command-r-plus-08-2024

# Base de Datos / Almacenamiento local (opcional para desarrollo)
DATABASE_URL=sqlite:///./mediflow.db

# Gemini: solo completar en mediflow/.env local. No hay modelo predeterminado.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=30
# true para modelos compatibles con JSON Schema; false mantiene validación local.
GEMINI_STRUCTURED_OUTPUT=true

# Agregado por Edil: general conserva las reglas anteriores. La alternativa
# synthetic_demo_v1 usa SOLO reglas experimentales del dataset confirmado
# sintético; no son criterios clínicos validados. Activar únicamente para demo.
TRIAGE_RULES_PROFILE=general

# Agregado por Edil: Tailscale solo transporta tráfico. El proveedor anterior
# de identidad queda inactivo; las cuentas se administran dentro de MediFlow.
MEDIFLOW_AUTH_MODE=disabled
MEDIFLOW_PUBLIC_ORIGIN=
MEDIFLOW_REVIEWER_LOGINS=
# Opcional: ruta de usuarios/sesiones del equipo servidor. Vacío usa
# mediflow/.local/auth.sqlite3; no copiar ni publicar esta base en Git.
MEDIFLOW_AUTH_DB_FILE=
# Opcional: duración de sesión, 900 a 43200 segundos; predeterminado ocho horas.
MEDIFLOW_SESSION_TTL_SECONDS=28800

# Agregado por Edil: usamos una sola sección Gemini y conservamos GEMINI_MODEL configurable.
# No copiamos el modelo fijo ni la línea separadora sin comentar de la entrega de Nicolás.
